<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicAI.Desktop.Views.ResearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:MechanicAI.Desktop.Helpers"
    xmlns:models="using:MechanicAI.Presentation.Models"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="8">
            <TextBlock Text="Research" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Sources are ranked by authority (manufacturer and government first). Summaries cite the sources they use." Style="{StaticResource MutedTextStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    PlaceholderText="e.g. 2014 F-150 3.5 EcoBoost cold start misfire TSB"
                    Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    KeyDown="OnQueryKeyDown" />
                <Button Grid.Column="1" Content="Search" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SearchCommand}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <CheckBox IsChecked="{x:Bind ViewModel.UseVehicleContext, Mode=TwoWay}" Content="Add active vehicle to the query" />
                <TextBlock Text="{x:Bind ViewModel.VehicleContext, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.SearchNotice, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.SearchNotice), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.StatusMessage), Mode=OneWay}" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Grid.ColumnSpan="2"
            IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind h:Ui.Severity(ViewModel.NoticeSeverity), Mode=OneWay}" />

        <!-- Sources -->
        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Sources" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" Margin="0" />
                <HyperlinkButton Content="Select all" Command="{x:Bind ViewModel.SelectAllSourcesCommand}" />
                <HyperlinkButton Content="Select none" Command="{x:Bind ViewModel.ClearSourceSelectionCommand}" />
                <Button Content="Summarize selected" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SummarizeCommand}" />
            </StackPanel>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Sources}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SourceItem">
                        <Grid ColumnSpacing="8" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <HyperlinkButton Content="{x:Bind Title}" Padding="0" Click="OnOpenSource" />
                                <TextBlock Style="{StaticResource MutedTextStyle}"><Run Text="{x:Bind Domain}" /><Run Text=" · " /><Run Text="{x:Bind Meta}" /></TextBlock>
                                <TextBlock Text="{x:Bind Snippet}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" VerticalAlignment="Top" Padding="6" Click="OnBookmarkSource" ToolTipService.ToolTip="Bookmark">
                                <FontIcon Glyph="&#xE8A4;" FontSize="12" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Summary -->
        <ScrollViewer Grid.Row="2" Grid.Column="1">
            <StackPanel Spacing="12" Padding="0,0,12,24">
                <TextBlock Text="Select sources and choose Summarize for a cited summary." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Collapsed(ViewModel.HasSummary), Mode=OneWay}" />
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasSummary), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Summary" Style="{StaticResource SectionHeaderStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Stop" Command="{x:Bind ViewModel.CancelOperationCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" />
                                <Button Content="Copy" Command="{x:Bind ViewModel.CopySummaryCommand}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.SummaryModel, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource BodyWrapStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SummaryWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Cited sources" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SummarySources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CitationItem">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock VerticalAlignment="Center"><Run Text="[" /><Run Text="{x:Bind Label}" /><Run Text="]" /></TextBlock>
                                        <HyperlinkButton Content="{x:Bind Title}" Click="OnOpenCitation" IsEnabled="{x:Bind HasUrl}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
