<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicAI.Desktop.Views.TrainingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:MechanicAI.Desktop.Helpers"
    xmlns:models="using:MechanicAI.Presentation.Models"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Text="Training" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Courses, quizzes, spaced-repetition flashcards and practice calculations." Style="{StaticResource MutedTextStyle}" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Grid.ColumnSpan="2"
            IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind h:Ui.Severity(ViewModel.NoticeSeverity), Mode=OneWay}" />

        <!-- Courses -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Courses}" SelectedItem="{x:Bind ViewModel.SelectedCourse, Mode=TwoWay}" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:CourseItem">
                    <StackPanel Padding="0,8" Spacing="4">
                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Meta}" Style="{StaticResource MutedTextStyle}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ProgressPercent}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Pivot Grid.Row="2" Grid.Column="1">
            <PivotItem Header="Lessons">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListView ItemsSource="{x:Bind ViewModel.Lessons}" SelectedItem="{x:Bind ViewModel.SelectedLesson, Mode=TwoWay}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LessonItem">
                                <Grid Padding="0,6" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind CompletedGlyph}" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Meta}" Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="12" Padding="0,0,12,24">
                            <TextBlock Text="Choose a course and a lesson." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Collapsed(ViewModel.HasLesson), Mode=OneWay}" />
                            <StackPanel Spacing="12" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasLesson), Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.LessonTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.LessonMeta, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.LessonSafety}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:WarningItem">
                                            <InfoBar IsOpen="True" IsClosable="False" Margin="0,0,0,8" Title="{x:Bind Title}" Message="{x:Bind Message}" Severity="{x:Bind h:Ui.WarningSeverity(IsCritical)}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Bind ViewModel.LessonBody, Mode=OneWay}" Style="{StaticResource BodyWrapStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Previous" Command="{x:Bind ViewModel.PreviousLessonCommand}" />
                                    <Button Content="Mark complete / incomplete" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.MarkLessonCompleteCommand}" />
                                    <Button Content="Next" Command="{x:Bind ViewModel.NextLessonCommand}" />
                                    <Button Content="Generate AI quiz" Command="{x:Bind ViewModel.GenerateAiQuizCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <PivotItem Header="Quizzes">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListView ItemsSource="{x:Bind ViewModel.Quizzes}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnQuizClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:QuizItem">
                                <StackPanel Padding="0,6">
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Meta}" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="12" Padding="0,0,12,24">
                            <TextBlock Text="Choose a quiz." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Collapsed(ViewModel.IsQuizActive), Mode=OneWay}" />
                            <StackPanel Spacing="12" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsQuizActive), Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.ActiveQuiz.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.QuizQuestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:QuizQuestionItem">
                                            <StackPanel Spacing="4" Margin="0,0,0,12">
                                                <RadioButtons Header="{x:Bind Header}" ItemsSource="{x:Bind Choices}" SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}" />
                                                <TextBlock Text="{x:Bind Feedback, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Visible(HasFeedback), Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Bind ViewModel.QuizResultText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.QuizResultText), Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Submit" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SubmitQuizCommand}" />
                                    <Button Content="Close" Command="{x:Bind ViewModel.CloseQuizCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <PivotItem Header="Flashcards">
                <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="{x:Bind ViewModel.FlashcardStatus, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                    <Button Content="Review due cards" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.StartFlashcardsCommand}" />
                    <Border Style="{StaticResource CardStyle}" MinHeight="180" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasCard), Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.CardFront, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.CardBack, Mode=OneWay}" Style="{StaticResource BodyWrapStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsCardFlipped), Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Show answer" Command="{x:Bind ViewModel.FlipCardCommand}" />
                                <Button Content="I knew it" Command="{x:Bind ViewModel.CardCorrectCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsCardFlipped), Mode=OneWay}" />
                                <Button Content="I didn't" Command="{x:Bind ViewModel.CardIncorrectCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsCardFlipped), Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </PivotItem>

            <PivotItem Header="Exercises">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,0,12,24" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Practice values are illustrative, not specifications for any vehicle." Style="{StaticResource MutedTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Width="260" ItemsSource="{x:Bind ViewModel.ExerciseTypes}" SelectedIndex="{x:Bind ViewModel.ExerciseTypeIndex, Mode=TwoWay}" />
                            <Button Content="New set" Command="{x:Bind ViewModel.GenerateExercisesCommand}" />
                            <Button Content="Check answers" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.CheckExercisesCommand}" />
                            <TextBlock Text="{x:Bind ViewModel.ExerciseScore, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Exercises}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ExerciseItem">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind Prompt}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind h:Ui.Collapsed(IsMultipleChoice)}">
                                                <TextBox Width="160" Text="{x:Bind Response, Mode=TwoWay}" PlaceholderText="Answer" />
                                                <TextBlock Text="{x:Bind Unit}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <RadioButtons ItemsSource="{x:Bind Choices}" SelectedIndex="{x:Bind SelectedChoice, Mode=TwoWay}" Visibility="{x:Bind h:Ui.Visible(IsMultipleChoice)}" />
                                            <TextBlock Text="{x:Bind Feedback, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Visible(HasFeedback), Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
