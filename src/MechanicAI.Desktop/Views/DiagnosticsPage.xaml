<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicAI.Desktop.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:MechanicAI.Desktop.Helpers"
    xmlns:models="using:MechanicAI.Presentation.Models"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Grid Grid.ColumnSpan="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Diagnostics" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Probabilities update with every recorded result. Go back at any time — the tree is recomputed from the evidence." Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NewSessionCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New session" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.StatusMessage), Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                Severity="{x:Bind h:Ui.Severity(ViewModel.NoticeSeverity), Mode=OneWay}" />
        </StackPanel>

        <!-- Sessions -->
        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ToggleSwitch Header="Show closed sessions" IsOn="{x:Bind ViewModel.ShowClosedSessions, Mode=TwoWay}" />
            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Sessions}"
                SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SessionItem">
                        <StackPanel Padding="0,8" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Vehicle}" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{x:Bind Codes}" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Style="{StaticResource MutedTextStyle}">
                                <Run Text="{x:Bind StatusText}" /><Run Text=" · " /><Run Text="{x:Bind Updated}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Workspace -->
        <ScrollViewer Grid.Row="2" Grid.Column="1">
            <StackPanel Spacing="16" Padding="0,0,12,24">

                <!-- New session form -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsNewSessionOpen), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="New diagnostic session" Style="{StaticResource SectionHeaderStyle}" />
                        <ComboBox
                            Header="Saved vehicle"
                            PlaceholderText="No saved vehicle"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.VehicleChoices}"
                            SelectedIndex="{x:Bind ViewModel.NewVehicleIndex, Mode=TwoWay}" />
                        <TextBox Header="Or describe the vehicle" PlaceholderText="e.g. 2017 Chevrolet Silverado 5.3L" Text="{x:Bind ViewModel.NewVehicleDescription, Mode=TwoWay}" />
                        <TextBox Header="Customer complaint" Text="{x:Bind ViewModel.NewComplaint, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Trouble codes" PlaceholderText="P0302, P0300" CharacterCasing="Upper" Text="{x:Bind ViewModel.NewDtcs, Mode=TwoWay}" />
                            <TextBox Grid.Column="1" Header="Mileage" Text="{x:Bind ViewModel.NewMileage, Mode=TwoWay}" InputScope="Number" />
                        </Grid>
                        <TextBox Header="Symptoms (comma separated)" PlaceholderText="rough idle, hesitation" Text="{x:Bind ViewModel.NewSymptoms, Mode=TwoWay}" />
                        <TextBox Header="Conditions (comma separated)" PlaceholderText="cold start, under load, in rain" Text="{x:Bind ViewModel.NewConditions, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind ViewModel.NewSessionError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.NewSessionError), Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Build diagnostic tree" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.StartSessionCommand}" />
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelNewSessionCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Empty state -->
                <StackPanel Spacing="8" Margin="0,48,0,0" HorizontalAlignment="Center" Visibility="{x:Bind h:Ui.Collapsed(ViewModel.HasSession), Mode=OneWay}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="40" />
                    <TextBlock Text="Select a session or start a new one." HorizontalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>

                <!-- Session -->
                <StackPanel Spacing="16" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasSession), Mode=OneWay}">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.SessionTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.VehicleDescription, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                    <Border Style="{StaticResource TagBorderStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsSample), Mode=OneWay}">
                                        <TextBlock Text="Sample" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                    <Border Style="{StaticResource TagBorderStyle}">
                                        <TextBlock Text="{x:Bind ViewModel.StageLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <ProgressBar Minimum="0" Maximum="{x:Bind ViewModel.StageCount}" Value="{x:Bind ViewModel.StageProgress, Mode=OneWay}" />

                            <TextBlock Style="{StaticResource BodyWrapStyle}"><Run Text="Complaint: " FontWeight="SemiBold" /><Run Text="{x:Bind ViewModel.Complaint, Mode=OneWay}" /></TextBlock>
                            <TextBlock Style="{StaticResource BodyWrapStyle}"><Run Text="Symptoms: " FontWeight="SemiBold" /><Run Text="{x:Bind ViewModel.SymptomsText, Mode=OneWay}" /></TextBlock>
                            <TextBlock Style="{StaticResource BodyWrapStyle}" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.FinalDiagnosis), Mode=OneWay}"><Run Text="Diagnosis: " FontWeight="SemiBold" /><Run Text="{x:Bind ViewModel.FinalDiagnosis, Mode=OneWay}" /></TextBlock>

                            <TextBlock Text="Trouble codes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Dtcs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnSpacing="8" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Padding="6" Click="OnRemoveDtc" ToolTipService.ToolTip="Remove code">
                                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="Add a code (e.g. P0301)" CharacterCasing="Upper" Text="{x:Bind ViewModel.NewDtcText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="Add code" Command="{x:Bind ViewModel.AddDtcCommand}" />
                            </Grid>

                            <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left">
                                <AppBarButton Label="AI analysis" Command="{x:Bind ViewModel.AnalyzeWithAiCommand}">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE99A;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Go back a step" Command="{x:Bind ViewModel.GoBackCommand}">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE7A7;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Reopen" Command="{x:Bind ViewModel.ReopenCommand}">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B0;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <CommandBar.SecondaryCommands>
                                    <AppBarButton Label="Close without repair" Command="{x:Bind ViewModel.AbandonCommand}">
                                        <AppBarButton.Icon><FontIcon Glyph="&#xE711;" /></AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton Label="Delete session" Command="{x:Bind ViewModel.DeleteSessionCommand}">
                                        <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                                    </AppBarButton>
                                </CommandBar.SecondaryCommands>
                            </CommandBar>
                            <TextBlock Text="{x:Bind ViewModel.AiActivity, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.AiActivity), Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Safety -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SafetyWarnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:WarningItem">
                                <InfoBar IsOpen="True" IsClosable="False" Margin="0,0,0,8" Title="{x:Bind Title}" Message="{x:Bind Message}" Severity="{x:Bind h:Ui.WarningSeverity(IsCritical)}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <InfoBar
                        IsOpen="{x:Bind ViewModel.EvidenceOutsideTree, Mode=OneWay}"
                        IsClosable="False"
                        Severity="Warning"
                        Title="Results don't fit the tree"
                        Message="The recorded results point outside the listed causes. Re-check results, research the vehicle, or run AI analysis to extend the tree." />

                    <!-- Initial checks -->
                    <Expander Header="Initial checks" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.InitialChecks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CheckItem">
                                    <CheckBox IsChecked="{x:Bind IsDone, Mode=TwoWay}">
                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!-- Next test -->
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasActiveTest), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Recommended test" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveTest.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveTest.Purpose, Mode=OneWay}" Style="{StaticResource BodyWrapStyle}" />
                            <TextBlock Style="{StaticResource MutedTextStyle}">
                                <Run Text="{x:Bind ViewModel.ActiveTest.Effort, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind ViewModel.ActiveTest.InformationGainText, Mode=OneWay}" /><Run Text=" · from " /><Run Text="{x:Bind ViewModel.ActiveTest.OriginText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="Procedure" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveTest.ProcedureText, Mode=OneWay}" Style="{StaticResource BodyWrapStyle}" />
                            <TextBlock Style="{StaticResource BodyWrapStyle}"><Run Text="Tools: " FontWeight="SemiBold" /><Run Text="{x:Bind ViewModel.ActiveTest.Tools, Mode=OneWay}" /></TextBlock>
                            <TextBlock Style="{StaticResource BodyWrapStyle}"><Run Text="Expected: " FontWeight="SemiBold" /><Run Text="{x:Bind ViewModel.ActiveTest.Expected, Mode=OneWay}" /></TextBlock>
                            <InfoBar
                                IsOpen="True"
                                IsClosable="False"
                                Severity="Informational"
                                Title="Look up the specification"
                                Message="{x:Bind ViewModel.ActiveTest.SpecificationNote, Mode=OneWay}"
                                Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.ActiveTest.SpecificationNote), Mode=OneWay}" />

                            <TextBlock Text="What did you find?" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                            <ListView
                                ItemsSource="{x:Bind ViewModel.ActiveTest.Outcomes, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedOutcome, Mode=TwoWay}"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:OutcomeOption">
                                        <StackPanel Padding="0,6">
                                            <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}"><Run Text="{x:Bind ResultText}" /><Run Text=" " /><Run Text="{x:Bind Interpretation}" /></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBox Header="Actual reading / observation (optional)" PlaceholderText="e.g. 11.8 V at the injector with key on" Text="{x:Bind ViewModel.ActualResult, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Record result" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RecordResultCommand}" />
                                <Button Content="Skip test" Command="{x:Bind ViewModel.SkipTestCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Other tests -->
                    <Expander Header="Other available tests (ranked)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ListView ItemsSource="{x:Bind ViewModel.RankedTests}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnTestClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TestItem">
                                    <StackPanel Padding="0,6">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource MutedTextStyle}"><Run Text="{x:Bind Effort}" /><Run Text=" · " /><Run Text="{x:Bind InformationGainText}" /></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>

                    <!-- Completed tests -->
                    <Expander Header="Recorded results" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.CompletedTests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TestItem">
                                    <Grid ColumnSpacing="8" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ResultText}" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Text="{x:Bind ActualResult}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.VisibleIfText(ActualResult)}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Undo" Click="OnRevertTest" ToolTipService.ToolTip="Remove this result and recompute" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!-- Clarifying questions -->
                    <Expander Header="Clarifying questions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasQuestions), Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Questions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:QuestionItem">
                                    <StackPanel Spacing="4" Padding="0,6">
                                        <TextBlock Text="{x:Bind Question}" TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{x:Bind Answer, Mode=TwoWay}" PlaceholderText="Answer" />
                                            <Button Grid.Column="1" Content="Save" Click="OnAnswerQuestion" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!-- Repair -->
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.CanRecordRepair), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Record the repair" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBox Header="Repair performed" Text="{x:Bind ViewModel.RepairDescription, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                            <TextBox Header="Labor hours" Width="160" HorizontalAlignment="Left" Text="{x:Bind ViewModel.LaborHours, Mode=TwoWay}" InputScope="Number" />
                            <Button Content="Record repair" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RecordRepairCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Verification -->
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.CanVerify), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Verify the repair" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBox Header="Verification notes" Text="{x:Bind ViewModel.VerificationNotes, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Complaint resolved" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.VerifyPassedCommand}" />
                                <Button Content="Complaint persists" Command="{x:Bind ViewModel.VerifyFailedCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Observations -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Add an observation" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBox Text="{x:Bind ViewModel.ObservationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" PlaceholderText="What you saw, heard, smelled or measured" />
                            <Button Content="Add to timeline" Command="{x:Bind ViewModel.AddObservationCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- AI summary -->
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasAiSummary), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="AI analysis" Style="{StaticResource SectionHeaderStyle}" />
                                <Border Style="{StaticResource TagBorderStyle}">
                                    <TextBlock Text="AI inference — verify" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.AiSummary, Mode=OneWay}" Style="{StaticResource BodyWrapStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Timeline -->
                    <Expander Header="Timeline (audit trail)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Timeline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StepItem">
                                    <StackPanel Padding="0,6" Opacity="1">
                                        <TextBlock Style="{StaticResource MutedTextStyle}"><Run Text="{x:Bind When}" /><Run Text=" · " /><Run Text="{x:Bind Actor}" /><Run Text=" " /><Run Text="{x:Bind Evidence}" /></TextBlock>
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Visible(HasDetail)}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Causes -->
        <ScrollViewer Grid.Row="2" Grid.Column="2" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasSession), Mode=OneWay}">
            <StackPanel Spacing="12" Padding="0,0,12,24">
                <TextBlock Text="Possible causes" Style="{StaticResource SectionHeaderStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Causes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:CauseItem">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12">
                                <StackPanel Spacing="4">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProbabilityText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </Grid>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ProbabilityPercent}" />
                                    <TextBlock Style="{StaticResource MutedTextStyle}">
                                        <Run Text="{x:Bind StatusText}" /><Run Text=" · " /><Run Text="{x:Bind Category}" /><Run Text=" · " /><Run Text="{x:Bind EvidenceText}" /><Run Text=" · " /><Run Text="{x:Bind OriginText}" />
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Content="Confirm" Click="OnConfirmCause" Padding="8,2" />
                                        <Button Content="Rule out" Click="OnRuleOutCause" Padding="8,2" />
                                        <Button Content="Reopen" Click="OnReopenCause" Padding="8,2" Visibility="{x:Bind h:Ui.Visible(IsRuledOut)}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="Add a cause you suspect" Text="{x:Bind ViewModel.NewCauseTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Add" Command="{x:Bind ViewModel.AddCauseCommand}" />
                </Grid>

                <TextBlock Text="Report" Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,0" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.ReportFormats}" SelectedIndex="{x:Bind ViewModel.ReportFormatIndex, Mode=TwoWay}" />
                    <Button Grid.Column="1" Content="Export" Command="{x:Bind ViewModel.ExportReportCommand}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
