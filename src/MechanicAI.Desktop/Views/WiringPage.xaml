<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicAI.Desktop.Views.WiringPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:MechanicAI.Desktop.Helpers"
    xmlns:models="using:MechanicAI.Presentation.Models"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Spacing="4">
            <TextBlock Text="Wiring diagrams" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Answers may only reference grounds, connectors, splices and fuses actually found on the diagram. Always verify on the vehicle." Style="{StaticResource MutedTextStyle}" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Grid.ColumnSpan="3"
            IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind h:Ui.Severity(ViewModel.NoticeSeverity), Mode=OneWay}" />

        <!-- Diagrams -->
        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView ItemsSource="{x:Bind ViewModel.Diagrams}" SelectedItem="{x:Bind ViewModel.SelectedDiagram, Mode=TwoWay}" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DocumentItem">
                        <StackPanel Padding="0,6">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource MutedTextStyle}"><Run Text="{x:Bind StatusText}" /><Run Text=" · " /><Run Text="{x:Bind Details}" /></TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="1" Spacing="8">
                <TextBlock Text="No wiring diagrams yet. Add a PDF or image of a diagram." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Collapsed(ViewModel.HasDiagrams), Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Add diagram" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.UploadDiagramCommand}" />
                    <Button Content="Open" Command="{x:Bind ViewModel.OpenDiagramCommand}" />
                    <Button Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Ask -->
        <ScrollViewer Grid.Row="2" Grid.Column="1">
            <StackPanel Spacing="16" Padding="0,0,12,24">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Ask about the circuit" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Question" Text="{x:Bind ViewModel.Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Where is the ground for the fuel pump?" />
                            <TextBox Grid.Column="1" Header="Page" PlaceholderText="All" Text="{x:Bind ViewModel.PageNumberText, Mode=TwoWay}" InputScope="Number" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Ask" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AskCommand}" />
                            <Button Content="Stop" Command="{x:Bind ViewModel.CancelOperationCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Text="Quick questions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.QuickQuestions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" ItemHeight="40" ItemWidth="300" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <HyperlinkButton Content="{x:Bind}" Click="OnQuickQuestion" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasAnswer), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Answer" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AnswerSource, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Answer, Mode=OneWay}" Style="{StaticResource BodyWrapStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Identifiers referenced" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Highlights}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WiringLabelItem">
                                    <TextBlock Style="{StaticResource MutedTextStyle}"><Run Text="{x:Bind Text}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{x:Bind KindText}" /><Run Text=" · page " /><Run Text="{x:Bind PageText}" /></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Identifiers -->
        <Grid Grid.Row="2" Grid.Column="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Identifiers on the diagram" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Filter (G101, C2, fuse…)" Text="{x:Bind ViewModel.LabelFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Command="{x:Bind ViewModel.ReloadLabelsCommand}" ToolTipService.ToolTip="Reload for the page above">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>
            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Labels}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:WiringLabelItem">
                        <Grid ColumnSpacing="8" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Text}" FontFamily="Consolas" IsTextSelectionEnabled="True" />
                            <TextBlock Grid.Column="1" Style="{StaticResource MutedTextStyle}"><Run Text="{x:Bind KindText}" /><Run Text=" p." /><Run Text="{x:Bind PageText}" /></TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
