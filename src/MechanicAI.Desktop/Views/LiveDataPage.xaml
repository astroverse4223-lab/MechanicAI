<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicAI.Desktop.Views.LiveDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:MechanicAI.Desktop.Helpers"
    xmlns:models="using:MechanicAI.Presentation.Models"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock Text="Live data" Style="{StaticResource PageTitleStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Choose an adapter"
                    ItemsSource="{x:Bind ViewModel.Adapters}"
                    SelectedItem="{x:Bind ViewModel.SelectedAdapter, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.IsDisconnected, Mode=OneWay}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Find adapters" Command="{x:Bind ViewModel.DiscoverCommand}" />
                    <Button Content="Connect" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ConnectCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsDisconnected), Mode=OneWay}" />
                    <Button Content="Disconnect" Command="{x:Bind ViewModel.DisconnectCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsConnected), Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
            </Grid>
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.StatusMessage), Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsSimulated, Mode=OneWay}"
                IsClosable="False"
                Severity="Warning"
                Title="SIMULATOR"
                Message="Values come from the built-in simulator, not a vehicle. Never use them for a diagnosis." />
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                Severity="{x:Bind h:Ui.Severity(ViewModel.NoticeSeverity), Mode=OneWay}" />
        </StackPanel>

        <Pivot Grid.Row="2">
            <PivotItem Header="Live">
                <Grid RowSpacing="8" ColumnSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Start streaming" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.StartStreamingCommand}" />
                        <Button Content="Stop" Command="{x:Bind ViewModel.StopStreamingCommand}" />
                        <TextBox Width="240" PlaceholderText="Recording title (optional)" Text="{x:Bind ViewModel.RecordingTitle, Mode=TwoWay}" />
                        <Button Command="{x:Bind ViewModel.StartRecordingCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C8;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="Record" />
                            </StackPanel>
                        </Button>
                        <Button Content="Stop recording" Command="{x:Bind ViewModel.StopRecordingCommand}" />
                        <TextBlock Text="● REC" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsRecording), Mode=OneWay}" />
                    </StackPanel>

                    <!-- PID selection -->
                    <Grid Grid.Row="1" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Parameters" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Defaults" HorizontalAlignment="Right" Command="{x:Bind ViewModel.SelectDefaultPidsCommand}" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Pids}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:PidValueItem">
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsSupported, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                    </CheckBox>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Values -->
                    <GridView Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind ViewModel.VisiblePids}" SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:PidValueItem">
                                <Border Style="{StaticResource CardStyle}" Width="220" Height="112" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                        <TextBlock Text="{x:Bind ValueText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <ProgressBar Minimum="{x:Bind Min}" Maximum="{x:Bind Max}" Value="{x:Bind GaugeValue, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Scan tool">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Read codes" Command="{x:Bind ViewModel.ReadDtcsCommand}" />
                        <Button Content="Freeze frame" Command="{x:Bind ViewModel.ReadFreezeFrameCommand}" />
                        <Button Content="Readiness monitors" Command="{x:Bind ViewModel.ReadMonitorsCommand}" />
                        <Button Content="Read VIN" Command="{x:Bind ViewModel.ReadVinCommand}" />
                        <Button Content="Clear codes…" Command="{x:Bind ViewModel.ClearDtcsCommand}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ScanTitle, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}" />
                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.ScanResults}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LabeledValue">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Recordings">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView ItemsSource="{x:Bind ViewModel.Recordings}" SelectedItem="{x:Bind ViewModel.SelectedRecording, Mode=TwoWay}" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:RecordingItem">
                                    <StackPanel Padding="0,6">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Started}" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Text="{x:Bind Details}" Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Refresh" Command="{x:Bind ViewModel.LoadRecordingsCommand}" />
                            <Button Content="Analyze with AI" Command="{x:Bind ViewModel.AnalyzeRecordingCommand}" />
                            <Button Content="Delete" Command="{x:Bind ViewModel.DeleteRecordingCommand}" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="12" Padding="0,0,12,24">
                            <TextBlock Text="Statistics" Style="{StaticResource SectionHeaderStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Statistics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PidStatItem">
                                        <Grid ColumnSpacing="12" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="240" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource MutedTextStyle}">
                                                <Run Text="min " /><Run Text="{x:Bind Min}" /><Run Text=" · max " /><Run Text="{x:Bind Max}" /><Run Text=" · mean " /><Run Text="{x:Bind Mean}" /><Run Text=" · σ " /><Run Text="{x:Bind StdDev}" /><Run Text=" " /><Run Text="{x:Bind Unit}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Observations" Style="{StaticResource SectionHeaderStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Observations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock TextWrapping="Wrap"><Run Text="• " /><Run Text="{x:Bind}" /></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasAnalysis), Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="AI review" Style="{StaticResource SectionHeaderStyle}" />
                                        <Border Style="{StaticResource TagBorderStyle}">
                                            <TextBlock Text="AI inference — verify" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.AnalysisText, Mode=OneWay}" Style="{StaticResource BodyWrapStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
