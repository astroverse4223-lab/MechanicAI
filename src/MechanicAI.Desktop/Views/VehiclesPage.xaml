<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicAI.Desktop.Views.VehiclesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:MechanicAI.Desktop.Helpers"
    xmlns:models="using:MechanicAI.Presentation.Models"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Text="Vehicles" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Decode a VIN for verified specifications, or add a vehicle by hand." Style="{StaticResource MutedTextStyle}" />
            <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Grid.ColumnSpan="2"
            IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind h:Ui.Severity(ViewModel.NoticeSeverity), Mode=OneWay}" />

        <!-- Vehicle list -->
        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <AutoSuggestBox
                PlaceholderText="Search by VIN, make, model, customer"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                QuerySubmitted="OnSearchSubmitted" />
            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Vehicles}"
                SelectedItem="{x:Bind ViewModel.SelectedVehicle, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:VehicleItem">
                        <Grid Padding="0,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{x:Bind RecallText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind h:Ui.Visible(HasOpenRecalls)}" />
                            </StackPanel>
                            <FontIcon Grid.Column="1" Glyph="{x:Bind FavoriteGlyph}" FontSize="14" Visibility="{x:Bind h:Ui.Visible(IsFavorite)}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Grid.Row="2" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.NewVehicleCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add vehicle manually" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2" Grid.Column="1">
            <StackPanel Spacing="16" Padding="0,0,12,0">

                <!-- VIN decode -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Decode a VIN" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Header="VIN"
                                PlaceholderText="17 characters"
                                MaxLength="24"
                                CharacterCasing="Upper"
                                Text="{x:Bind ViewModel.VinInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Description="{x:Bind ViewModel.VinCharacterCount, Mode=OneWay}" />
                            <TextBox Grid.Column="1" Header="Mileage (optional)" Text="{x:Bind ViewModel.VinMileage, Mode=TwoWay}" InputScope="Number" />
                            <Button Grid.Column="2" VerticalAlignment="Top" Margin="0,28,0,0" Content="Decode" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.DecodeVinCommand}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.VinValidationMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.VinValidationMessage), Mode=OneWay}" />
                        <StackPanel Spacing="4" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasDecodeResult), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.DecodeSummary, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DecodeDetail, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                            <Expander Header="Decoded fields" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DecodedFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:LabeledValue">
                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource MutedTextStyle}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <Button Content="Save vehicle" Command="{x:Bind ViewModel.SaveDecodedVehicleCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Editor -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsEditorOpen), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Header="Year" Text="{x:Bind ViewModel.EditYear, Mode=TwoWay}" InputScope="Number" />
                            <TextBox Grid.Column="1" Header="Make *" Text="{x:Bind ViewModel.EditMake, Mode=TwoWay}" />
                            <TextBox Grid.Column="2" Header="Model *" Text="{x:Bind ViewModel.EditModel, Mode=TwoWay}" />
                            <TextBox Grid.Column="3" Header="Trim" Text="{x:Bind ViewModel.EditTrim, Mode=TwoWay}" />
                            <TextBox Grid.Row="1" Grid.ColumnSpan="2" Header="Engine" Text="{x:Bind ViewModel.EditEngine, Mode=TwoWay}" />
                            <TextBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Header="VIN" CharacterCasing="Upper" Text="{x:Bind ViewModel.EditVin, Mode=TwoWay}" />
                            <TextBox Grid.Row="2" Header="Mileage" Text="{x:Bind ViewModel.EditMileage, Mode=TwoWay}" InputScope="Number" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Header="Unit" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.MileageUnits}" SelectedIndex="{x:Bind ViewModel.EditMileageUnitIndex, Mode=TwoWay}" />
                            <TextBox Grid.Row="2" Grid.Column="2" Header="License plate" Text="{x:Bind ViewModel.EditPlate, Mode=TwoWay}" />
                            <TextBox Grid.Row="2" Grid.Column="3" Header="Color" Text="{x:Bind ViewModel.EditColor, Mode=TwoWay}" />
                        </Grid>
                        <TextBox Header="Notes" Text="{x:Bind ViewModel.EditNotes, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                        <TextBlock Text="{x:Bind ViewModel.EditorError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.EditorError), Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveVehicleCommand}" />
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelEditCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Selected vehicle -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasSelection), Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DetailSubtitle, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DetailSource, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.DetailVin), Mode=OneWay}">
                            <TextBlock Text="VIN" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.DetailVin, Mode=OneWay}" FontFamily="Consolas" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                            <Button Command="{x:Bind ViewModel.CopyVinCommand}" ToolTipService.ToolTip="Copy VIN" Padding="6">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                            </Button>
                        </StackPanel>

                        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" IsDynamicOverflowEnabled="True">
                            <AppBarButton Label="Diagnose" Command="{x:Bind ViewModel.StartDiagnosisCommand}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE9D9;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Set active" Command="{x:Bind ViewModel.SetActiveCommand}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE73E;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="History" Command="{x:Bind ViewModel.OpenHistoryCommand}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE81C;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Check recalls" Command="{x:Bind ViewModel.RefreshRecallsCommand}">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE895;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <CommandBar.SecondaryCommands>
                                <AppBarButton Label="Edit" Command="{x:Bind ViewModel.EditVehicleCommand}">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Favorite" Command="{x:Bind ViewModel.ToggleFavoriteCommand}">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE734;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Re-decode VIN" Command="{x:Bind ViewModel.RedecodeCommand}">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarSeparator />
                                <AppBarButton Label="Delete" Command="{x:Bind ViewModel.DeleteVehicleCommand}">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar.SecondaryCommands>
                        </CommandBar>

                        <TextBlock Text="This is the active vehicle." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsActiveVehicle), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.DetailNotes, Mode=OneWay}" Style="{StaticResource BodyWrapStyle}" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.DetailNotes), Mode=OneWay}" />

                        <Expander Header="Specifications" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Specifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LabeledValue">
                                        <Grid ColumnSpacing="12" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Expander Header="Recalls (NHTSA)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Recalls}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:RecallItem">
                                        <StackPanel Padding="0,6" Spacing="2">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                                <Run Text="{x:Bind Campaign}" /><Run Text=" — " /><Run Text="{x:Bind Component}" />
                                            </TextBlock>
                                            <TextBlock Text="DO NOT DRIVE — park-it advisory" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind h:Ui.Visible(ParkIt)}" />
                                            <TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyWrapStyle}" />
                                            <TextBlock Text="{x:Bind Remedy}" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}"><Run Text="Status: " /><Run Text="{x:Bind StatusText}" /></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
