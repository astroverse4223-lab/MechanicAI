<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicAI.Desktop.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:MechanicAI.Desktop.Helpers"
    xmlns:models="using:MechanicAI.Presentation.Models"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="8">
            <TextBlock Text="History" Style="{StaticResource PageTitleStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Choose a vehicle" ItemsSource="{x:Bind ViewModel.Vehicles}" SelectedItem="{x:Bind ViewModel.SelectedVehicle, Mode=TwoWay}" />
                <TextBox Grid.Column="1" PlaceholderText="Filter (code, part, keyword)" Text="{x:Bind ViewModel.Filter, Mode=TwoWay}" />
                <Button Grid.Column="2" Content="Apply" Command="{x:Bind ViewModel.ApplyFilterCommand}" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Grid.ColumnSpan="2"
            IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind h:Ui.Severity(ViewModel.NoticeSeverity), Mode=OneWay}" />

        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="No history for this vehicle yet." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Collapsed(ViewModel.HasEntries), Mode=OneWay}" />
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Entries}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnEntryClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryEntryItem">
                        <Grid Padding="0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind When}" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{x:Bind Kind}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MutedTextStyle}" MaxLines="3" TextTrimming="CharacterEllipsis" Visibility="{x:Bind h:Ui.Visible(HasDetail)}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ScrollViewer Grid.Row="2" Grid.Column="1">
            <StackPanel Spacing="16" Padding="0,0,12,24">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Trouble-code history" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DtcHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DtcOccurrenceItem">
                                    <TextBlock><Run Text="{x:Bind Code}" FontWeight="SemiBold" /><Run Text=" · seen " /><Run Text="{x:Bind OccurrencesText}" /><Run Text=" · last " /><Run Text="{x:Bind LastSeen}" /></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Shop knowledge" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="Search confirmed diagnoses across every vehicle you have worked on." Style="{StaticResource MutedTextStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox PlaceholderText="e.g. P0171 Silverado" Text="{x:Bind ViewModel.KnowledgeQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Search" Command="{x:Bind ViewModel.SearchKnowledgeCommand}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.StatusMessage), Mode=OneWay}" />
                        <ListView ItemsSource="{x:Bind ViewModel.ConfirmedDiagnoses}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnDiagnosisClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ConfirmedDiagnosisItem">
                                    <StackPanel Padding="0,6">
                                        <TextBlock Text="{x:Bind Diagnosis}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Vehicle}" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Style="{StaticResource MutedTextStyle}"><Run Text="{x:Bind Codes}" /><Run Text=" · " /><Run Text="{x:Bind When}" /></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
