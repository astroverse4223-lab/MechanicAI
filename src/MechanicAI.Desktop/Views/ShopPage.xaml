<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicAI.Desktop.Views.ShopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:MechanicAI.Desktop.Helpers"
    xmlns:models="using:MechanicAI.Presentation.Models"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Shop" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.StatusMessage), Mode=OneWay}" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind h:Ui.Severity(ViewModel.NoticeSeverity), Mode=OneWay}" />

        <Pivot Grid.Row="2">
            <!-- Estimates -->
            <PivotItem Header="Estimates">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Content="New estimate" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.NewEstimateCommand}" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Estimates}" SelectedItem="{x:Bind ViewModel.SelectedEstimate, Mode=TwoWay}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnEstimateClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:EstimateItem">
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock><Run Text="{x:Bind Number}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{x:Bind StatusText}" /></TextBlock>
                                            <TextBlock Text="{x:Bind Customer}" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Text="{x:Bind Vehicle}" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{x:Bind TotalText}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right" />
                                            <HyperlinkButton Content="Delete" Padding="0" HorizontalAlignment="Right" Click="OnDeleteEstimate" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="12" Padding="0,0,12,24">
                            <TextBlock Text="Choose an estimate to edit or create a new one." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Collapsed(ViewModel.IsEstimateEditorOpen), Mode=OneWay}" />
                            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsEstimateEditorOpen), Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.EstimateTitle, Mode=OneWay}" Style="{StaticResource SectionHeaderStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Header="Customer" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.CustomerChoices}" SelectedIndex="{x:Bind ViewModel.EstimateCustomerIndex, Mode=TwoWay}" />
                                        <ComboBox Grid.Column="1" Header="Vehicle" PlaceholderText="No vehicle" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.VehicleChoices}" SelectedIndex="{x:Bind ViewModel.EstimateVehicleIndex, Mode=TwoWay}" />
                                        <ComboBox Grid.Column="2" Header="Status" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.EstimateStatuses}" SelectedIndex="{x:Bind ViewModel.EstimateStatusIndex, Mode=TwoWay}" />
                                        <TextBox Grid.Column="3" Header="Tax %" Text="{x:Bind ViewModel.TaxRatePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" />
                                    </Grid>

                                    <TextBlock Text="Lines" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.EstimateLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:EstimateLineItem">
                                                <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind Kinds}" SelectedIndex="{x:Bind KindIndex, Mode=TwoWay}" />
                                                    <TextBox Grid.Column="1" PlaceholderText="Description" Text="{x:Bind Description, Mode=TwoWay}" />
                                                    <TextBox Grid.Column="2" PlaceholderText="Part #" Text="{x:Bind PartNumber, Mode=TwoWay}" />
                                                    <TextBox Grid.Column="3" PlaceholderText="Qty/hrs" Text="{x:Bind QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" />
                                                    <TextBox Grid.Column="4" PlaceholderText="Price" Text="{x:Bind UnitPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" />
                                                    <CheckBox Grid.Column="5" Content="Tax" MinWidth="0" IsChecked="{x:Bind Taxable, Mode=TwoWay}" />
                                                    <TextBlock Grid.Column="6" Text="{x:Bind TotalText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    <Button Grid.Column="7" Padding="6" Click="OnRemoveLine" ToolTipService.ToolTip="Remove line">
                                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Add line" Command="{x:Bind ViewModel.AddLineCommand}" />

                                    <StackPanel HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock HorizontalAlignment="Right"><Run Text="Subtotal " /><Run Text="{x:Bind ViewModel.SubtotalText, Mode=OneWay}" /></TextBlock>
                                        <TextBlock HorizontalAlignment="Right"><Run Text="Tax " /><Run Text="{x:Bind ViewModel.TaxText, Mode=OneWay}" /></TextBlock>
                                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}"><Run Text="Total " /><Run Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>

                                    <TextBox Header="Notes" Text="{x:Bind ViewModel.EstimateNotes, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                                    <TextBlock Text="{x:Bind ViewModel.EstimateError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.EstimateError), Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Save estimate" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveEstimateCommand}" />
                                        <Button Content="Cancel" Command="{x:Bind ViewModel.CancelEstimateCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <!-- Inspections -->
            <PivotItem Header="Inspections">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="New multi-point inspection" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ComboBox Header="Vehicle" PlaceholderText="Choose a vehicle" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.VehicleChoices}" SelectedIndex="{x:Bind ViewModel.InspectionVehicleIndex, Mode=TwoWay}" />
                                <TextBox Header="Mileage" Text="{x:Bind ViewModel.InspectionMileage, Mode=TwoWay}" InputScope="Number" />
                                <Button Content="Start inspection" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.StartInspectionCommand}" />
                            </StackPanel>
                        </Border>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Inspections}" SelectedItem="{x:Bind ViewModel.SelectedInspection, Mode=TwoWay}" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:InspectionSummaryItem">
                                    <StackPanel Padding="0,6">
                                        <TextBlock Text="{x:Bind Vehicle}" />
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Style="{StaticResource MutedTextStyle}"><Run Text="{x:Bind StatusText}" /><Run Text=" " /><Run Text="{x:Bind Summary}" /></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save" Command="{x:Bind ViewModel.SaveInspectionCommand}" />
                            <Button Content="Complete inspection" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.CompleteInspectionCommand}" />
                        </StackPanel>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.InspectionPoints}" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:InspectionPointItem">
                                    <Grid ColumnSpacing="8" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Section}" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Ratings}" SelectedIndex="{x:Bind RatingIndex, Mode=TwoWay}" />
                                        <TextBox Grid.Column="2" PlaceholderText="Measurement" Text="{x:Bind Measurement, Mode=TwoWay}" />
                                        <TextBox Grid.Column="3" PlaceholderText="Notes" Text="{x:Bind Notes, Mode=TwoWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- Customers -->
            <PivotItem Header="Customers">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <AutoSuggestBox PlaceholderText="Search customers" QueryIcon="Find" Text="{x:Bind ViewModel.CustomerSearch, Mode=TwoWay}" QuerySubmitted="OnCustomerSearch" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Customers}" SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnCustomerClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CustomerItem">
                                    <StackPanel Padding="0,6">
                                        <TextBlock Text="{x:Bind DisplayName}" />
                                        <TextBlock Text="{x:Bind Contact}" Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="New customer" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NewCustomerCommand}" />
                            <Button Content="Delete" Click="OnDeleteCustomer" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Column="1">
                        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsCustomerEditorOpen), Mode=OneWay}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Customer" Style="{StaticResource SectionHeaderStyle}" />
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox Header="First name" Text="{x:Bind ViewModel.CustomerFirstName, Mode=TwoWay}" />
                                    <TextBox Grid.Column="1" Header="Last name" Text="{x:Bind ViewModel.CustomerLastName, Mode=TwoWay}" />
                                    <TextBox Grid.Row="1" Grid.ColumnSpan="2" Header="Company" Text="{x:Bind ViewModel.CustomerCompany, Mode=TwoWay}" />
                                    <TextBox Grid.Row="2" Header="Phone" Text="{x:Bind ViewModel.CustomerPhone, Mode=TwoWay}" InputScope="TelephoneNumber" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Header="Email" Text="{x:Bind ViewModel.CustomerEmail, Mode=TwoWay}" InputScope="EmailSmtpAddress" />
                                    <TextBox Grid.Row="3" Grid.ColumnSpan="2" Header="Address" Text="{x:Bind ViewModel.CustomerAddress, Mode=TwoWay}" />
                                    <TextBox Grid.Row="4" Header="City" Text="{x:Bind ViewModel.CustomerCity, Mode=TwoWay}" />
                                    <Grid Grid.Row="4" Grid.Column="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Header="State / region" Text="{x:Bind ViewModel.CustomerRegion, Mode=TwoWay}" />
                                        <TextBox Grid.Column="1" Header="Postal code" Text="{x:Bind ViewModel.CustomerPostalCode, Mode=TwoWay}" />
                                    </Grid>
                                </Grid>
                                <TextBox Header="Notes" Text="{x:Bind ViewModel.CustomerNotes, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                                <TextBlock Text="{x:Bind ViewModel.CustomerError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.CustomerError), Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCustomerCommand}" />
                                    <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCustomerCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
