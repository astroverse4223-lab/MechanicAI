<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicAI.Desktop.Views.KnowledgeBasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:MechanicAI.Desktop.Helpers"
    xmlns:models="using:MechanicAI.Presentation.Models"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Text="Knowledge base" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Your service manuals, TSBs and notes — stored and searched on this workstation. Answers cite document and page." Style="{StaticResource MutedTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.StatsText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.IndexingStatus, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind h:Ui.VisibleIfText(ViewModel.IndexingStatus), Mode=OneWay}" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Grid.ColumnSpan="2"
            IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind h:Ui.Severity(ViewModel.NoticeSeverity), Mode=OneWay}" />

        <!-- Documents -->
        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox HorizontalAlignment="Stretch" Header="Upload as" ItemsSource="{x:Bind ViewModel.UploadKinds}" SelectedIndex="{x:Bind ViewModel.UploadKindIndex, Mode=TwoWay}" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.UploadCommand}" ToolTipService.ToolTip="PDF, images (PNG, JPEG, TIFF, BMP, WebP), and text/Markdown files">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE898;" FontSize="14" />
                        <TextBlock Text="Add documents" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox PlaceholderText="Filter by title" QueryIcon="Filter" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" QuerySubmitted="OnFilterSubmitted" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.FilterKinds}" SelectedIndex="{x:Bind ViewModel.FilterKindIndex, Mode=TwoWay}" />
            </Grid>
            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Documents}" SelectedItem="{x:Bind ViewModel.SelectedDocument, Mode=TwoWay}" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DocumentItem">
                        <StackPanel Padding="0,6" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource MutedTextStyle}"><Run Text="{x:Bind KindText}" /><Run Text=" · " /><Run Text="{x:Bind StatusText}" /><Run Text=" · " /><Run Text="{x:Bind Details}" /></TextBlock>
                            <TextBlock Text="{x:Bind StatusMessage}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Visible(HasStatusMessage)}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                <Button Content="Open" Command="{x:Bind ViewModel.OpenDocumentCommand}" />
                <Button Content="Re-index" Command="{x:Bind ViewModel.ReindexCommand}" />
                <Button Content="Delete" Command="{x:Bind ViewModel.DeleteDocumentCommand}" />
                <Button Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Ask -->
        <ScrollViewer Grid.Row="2" Grid.Column="1">
            <StackPanel Spacing="16" Padding="0,0,12,24">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Ask your documents" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox HorizontalAlignment="Stretch" Header="Question type" ItemsSource="{x:Bind ViewModel.Templates}" SelectedIndex="{x:Bind ViewModel.TemplateIndex, Mode=TwoWay}" />
                            <TextBox
                                Grid.Column="1"
                                Header="Question"
                                PlaceholderText="e.g. front caliper bracket bolt torque"
                                Text="{x:Bind ViewModel.Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <CheckBox Content="Only the selected document" IsChecked="{x:Bind ViewModel.LimitToSelectedDocument, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Ask" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AskCommand}" />
                            <Button Content="Find passages only" Command="{x:Bind ViewModel.SearchPassagesCommand}" />
                            <Button Content="Stop" Command="{x:Bind ViewModel.CancelOperationCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasAnswer), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Answer" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AnswerModel, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Answer, Mode=OneWay}" Style="{StaticResource BodyWrapStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AnswerWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Sources" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AnswerSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CitationItem">
                                    <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="[" /><Run Text="{x:Bind Label}" /><Run Text="] " /><Run Text="{x:Bind Title}" /><Run Text=" — " /><Run Text="{x:Bind Detail}" /></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="Passages" Style="{StaticResource SectionHeaderStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Passages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PassageItem">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"><Run Text="{x:Bind Location}" /><Run Text=" · " /><Run Text="{x:Bind MatchType}" /></TextBlock>
                                    <TextBlock Text="{x:Bind Heading}" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Text="{x:Bind Text}" Style="{StaticResource BodyWrapStyle}" MaxLines="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
