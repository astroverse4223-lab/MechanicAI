<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicAI.Desktop.Views.DtcPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:MechanicAI.Desktop.Helpers"
    xmlns:models="using:MechanicAI.Presentation.Models"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="8">
            <TextBlock Text="Trouble codes" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{x:Bind ViewModel.DatabaseText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    PlaceholderText="Code (P0301), partial code (P03), or words (misfire)"
                    Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    KeyDown="OnQueryKeyDown" />
                <TextBox Grid.Column="1" PlaceholderText="Make (optional)" Text="{x:Bind ViewModel.Make, Mode=TwoWay}" />
                <Button Grid.Column="2" Content="Search" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SearchCommand}" />
            </Grid>
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Grid.ColumnSpan="2"
            IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind h:Ui.Severity(ViewModel.NoticeSeverity), Mode=OneWay}" />

        <ListView
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Results}"
            SelectedItem="{x:Bind ViewModel.SelectedResult, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DtcResultItem">
                    <StackPanel Padding="0,8" Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap">
                            <Run Text="{x:Bind Code}" /><Run Text=" — " /><Run Text="{x:Bind Description}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedTextStyle}">
                            <Run Text="{x:Bind Subsystem}" /><Run Text=" · " /><Run Text="{x:Bind Scope}" />
                        </TextBlock>
                        <TextBlock Text="Diagnostic playbook available" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind h:Ui.Visible(HasPlaybook)}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer Grid.Row="2" Grid.Column="1">
            <StackPanel Spacing="16" Padding="0,0,12,24">
                <TextBlock Text="Search for a code to see its definition, likely causes, and diagnostic playbooks." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Collapsed(ViewModel.HasDetail), Mode=OneWay}" />

                <StackPanel Spacing="16" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasDetail), Mode=OneWay}">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.DetailCode, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" FontFamily="Consolas" />
                            <TextBlock Text="{x:Bind ViewModel.DetailDescription, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.DetailSystem, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DetailScope, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SeenText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                            <InfoBar
                                IsOpen="{x:Bind ViewModel.IsUnknownCode, Mode=OneWay}"
                                IsClosable="False"
                                Severity="Warning"
                                Title="Not in the offline database"
                                Message="This code may be manufacturer-specific. Verify its meaning in the OEM service information before diagnosing." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Start diagnosis" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.StartDiagnosisCommand}" />
                                <Button Content="Copy" Command="{x:Bind ViewModel.CopyCodeCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.SafetyWarnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:WarningItem">
                                <InfoBar IsOpen="True" IsClosable="False" Margin="0,0,0,8" Title="{x:Bind Title}" Message="{x:Bind Message}" Severity="{x:Bind h:Ui.WarningSeverity(IsCritical)}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Definitions" Style="{StaticResource SectionHeaderStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Definitions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DefinitionItem">
                                        <StackPanel Padding="0,4" Spacing="2">
                                            <TextBlock TextWrapping="Wrap"><Run Text="{x:Bind Scope}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{x:Bind Description}" /></TextBlock>
                                            <TextBlock Style="{StaticResource MutedTextStyle}"><Run Text="Source: " /><Run Text="{x:Bind Source}" /></TextBlock>
                                            <TextBlock Text="{x:Bind Notes}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Visible(HasNotes)}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Common causes" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="General possibilities — not confirmed for this vehicle." Style="{StaticResource MutedTextStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.PossibleCauses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock TextWrapping="Wrap"><Run Text="• " /><Run Text="{x:Bind}" /></TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Common symptoms" Style="{StaticResource SectionHeaderStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Symptoms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock TextWrapping="Wrap"><Run Text="• " /><Run Text="{x:Bind}" /></TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Diagnostic playbooks" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="No built-in playbook covers this code yet." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Collapsed(ViewModel.HasPlaybooks), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Playbooks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PlaybookItem">
                                        <Expander Header="{x:Bind Title}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyWrapStyle}" />
                                                <TextBlock Text="Candidate causes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <ItemsControl ItemsSource="{x:Bind Causes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="Tests" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <ItemsControl ItemsSource="{x:Bind Tests}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Related codes" Style="{StaticResource SectionHeaderStyle}" />
                            <ListView ItemsSource="{x:Bind ViewModel.RelatedCodes}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnRelatedClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
