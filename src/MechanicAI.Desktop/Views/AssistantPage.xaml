<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MechanicAI.Desktop.Views.AssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:MechanicAI.Desktop.Helpers"
    xmlns:models="using:MechanicAI.Presentation.Models"
    NavigationCacheMode="Required">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Text="Assistant" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="The assistant looks things up with tools (VIN decode, DTC database, your documents, web, history) and cites what it used. Treat its reasoning as AI inference." Style="{StaticResource MutedTextStyle}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Grid.ColumnSpan="2"
            IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind h:Ui.Severity(ViewModel.NoticeSeverity), Mode=OneWay}" />

        <!-- Conversations -->
        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NewConversationCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="New conversation" />
                </StackPanel>
            </Button>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Conversations}" SelectedItem="{x:Bind ViewModel.SelectedConversation, Mode=TwoWay}" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ConversationItem">
                        <Grid Padding="0,6" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE718;" FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0" Visibility="{x:Bind h:Ui.Visible(IsPinned)}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Updated}" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Rename" Command="{x:Bind ViewModel.RenameConversationCommand}" />
                <Button Content="Pin" Command="{x:Bind ViewModel.TogglePinCommand}" />
                <Button Content="Delete" Command="{x:Bind ViewModel.DeleteConversationCommand}" />
            </StackPanel>
        </Grid>

        <!-- Chat -->
        <Grid Grid.Row="2" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsEmpty), Mode=OneWay}">
                <FontIcon Glyph="&#xE8BD;" FontSize="40" />
                <TextBlock Text="Ask about a code, a symptom, a procedure, or the active vehicle." Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>

            <ListView x:Name="MessageList" ItemsSource="{x:Bind ViewModel.Messages}" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessageItem">
                        <Border
                            Style="{StaticResource CardStyle}"
                            Margin="0,6"
                            Padding="12"
                            MaxWidth="820"
                            HorizontalAlignment="{x:Bind h:Ui.BubbleAlignment(IsUser)}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Author}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Text, Mode=OneWay}" Style="{StaticResource BodyWrapStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind h:Ui.Visible(HasActivity), Mode=OneWay}">
                                    <ProgressRing IsActive="{x:Bind HasActivity, Mode=OneWay}" Width="14" Height="14" />
                                    <TextBlock Text="{x:Bind Activity, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Footer, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind h:Ui.Visible(HasFooter), Mode=OneWay}" />
                                <HyperlinkButton Content="Copy" Padding="0" Click="OnCopyMessage" Visibility="{x:Bind h:Ui.Visible(IsAssistant)}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind h:Ui.Visible(ViewModel.HasAttachments), Mode=OneWay}">
                <FontIcon Glyph="&#xE723;" FontSize="14" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Attachments}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" Style="{StaticResource MutedTextStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <HyperlinkButton Content="Remove" Command="{x:Bind ViewModel.ClearAttachmentsCommand}" />
            </StackPanel>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button VerticalAlignment="Bottom" Command="{x:Bind ViewModel.AttachImageCommand}" ToolTipService.ToolTip="Attach photos">
                    <FontIcon Glyph="&#xE722;" FontSize="14" />
                </Button>
                <TextBox
                    Grid.Column="1"
                    PlaceholderText="Message the assistant (Enter to send, Shift+Enter for a new line)"
                    Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MaxHeight="160"
                    PreviewKeyDown="OnDraftPreviewKeyDown" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Content="Stop" Command="{x:Bind ViewModel.StopCommand}" Visibility="{x:Bind h:Ui.Visible(ViewModel.IsSending), Mode=OneWay}" />
                    <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SendCommand}" ToolTipService.ToolTip="Send">
                        <FontIcon Glyph="&#xE724;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
