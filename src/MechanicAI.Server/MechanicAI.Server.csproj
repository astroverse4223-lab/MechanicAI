<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MechanicAI.Server</RootNamespace>
    <Description>Mechanic AI shop server: optional multi-workstation API (PostgreSQL + pgvector, JWT auth) that shares customers, vehicles, diagnostic sessions, and the knowledge base across workstations.</Description>
    <UserSecretsId>mechanicai-server-7d1c0f3e</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MechanicAI.Application\MechanicAI.Application.csproj" />
    <ProjectReference Include="..\MechanicAI.Infrastructure\MechanicAI.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MechanicAI.Server.Tests" />
  </ItemGroup>

</Project>
