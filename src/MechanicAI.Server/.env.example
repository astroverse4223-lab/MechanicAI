# Copy to .env (git-ignored) and replace every value. Never commit the real file.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# At least 32 bytes, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=replace-with-output-of-openssl-rand-base64-48
# First start only; remove both after the owner account exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Set to redis:6379 when starting with `--profile redis`.
REDIS_CONNECTION=
SERVER_PORT=8080
AI_MODE=Disabled
