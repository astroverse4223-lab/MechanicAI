{
  "ConnectionStrings": {
    "MechanicAI": "",
    "Redis": ""
  },
  "Database": {
    "Provider": "Postgres",
    "ApplyMigrationsOnStartup": true
  },
  "Storage": {
    "DataRoot": ""
  },
  "Jwt": {
    "Issuer": "MechanicAI.Server",
    "Audience": "MechanicAI.Workstation",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "ClockSkewSeconds": 30
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 12
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminDisplayName": "Shop owner"
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Api": {
      "PermitLimit": 600,
      "WindowSeconds": 60
    }
  },
  "Uploads": {
    "MaxDocumentBytes": 104857600
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Https": {
    "Redirect": false,
    "Hsts": false
  },
  "App": {
    "Ai": {
      "Mode": "Disabled",
      "OllamaBaseUrl": "http://localhost:11434"
    },
    "Search": {
      "Provider": "None"
    },
    "VehicleData": {
      "AutoCheckRecalls": true
    },
    "Privacy": {
      "AllowCloudAi": false,
      "AllowDocumentsInCloud": false
    },
    "Diagnostics": {
      "ShopName": ""
    }
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
